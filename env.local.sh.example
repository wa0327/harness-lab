# 這台機器自己的設定。複製成 env.local.sh 後修改（env.local.sh 不進版控）：
#   cp env.local.sh.example env.local.sh
# env.sh 會在預設值之前讀入這個檔案。
# 一律用 `: "${變數:=值}"` 的寫法，命令列上的環境變數（如 N_CPU_MOE=32 scripts/serve-main.sh）才能繼續優先。

# --- 對外開放 ---
# 預設只聽本機（127.0.0.1）、不驗證。要讓區網內其它電腦使用時，兩行一起打開：
# : "${HOST:=0.0.0.0}"
# : "${API_KEY=換成你的key}"   # 只用英數字與符號，例如用 openssl rand -hex 16 產生
# 另外要改 .home 裡的設定，Pi、Codex 才會送 key（見 README「對外開放與 API key」）：
#   .home/codex/config.toml 的 `# env_key = "API_KEY"` 取消註解
#   .home/pi/models.json 的 "apiKey": "none" 改成 "$API_KEY"

# --- 依硬體調整（用 scripts/bench-moe.sh 實測後填入） ---
# 各模型的 --n-cpu-moe：挑「最小又不 OOM」的值，再留一點餘裕（伺服器開 64K context 比跑分多吃 VRAM）
# : "${N_CPU_MOE_QWEN:=38}"
# : "${N_CPU_MOE_GLM:=38}"
# 預填用的 batch；VRAM 不夠時降回 2048
# : "${BATCH:=4096}" "${UBATCH:=4096}"
# 執行緒數，預設是實體核心數
# : "${THREADS:=16}"

# --- 驅動太舊、不支援 CUDA 13 時，改用 12.8 版 llama.cpp（要重跑 scripts/install-llama.sh） ---
# : "${LLAMA_CUDA:=12.8}"

# --- 預設主模型（qwen｜glm） ---
# : "${MODEL:=qwen}"
